    },
    {
      "parameters":{"jsCode":"const input = $json.body ?? $json;\nconst name = String(input.name ?? '').trim();\nconst email = String(input.email ?? '').trim().toLowerCase();\nconst company = String(input.company ?? '').trim();\nconst interest = String(input.interest ?? '').trim().toLowerCase();\nconst employees = Number(input.employees ?? 0);\nconst emailValid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nconst errors=[];\nif(!name) errors.push('name is required');\nif(!email) errors.push('email is required'); else if(!emailValid) errors.push('email is invalid');\nif(errors.length) return [{json:{success:false,errors,receivedAt:new Date().toISOString()}}];\nreturn [{json:{success:true,lead:{name,email,company,interest,employees:Number.isFinite(employees)?employees:0},receivedAt:new Date().toISOString()}}];"},
      "id":"validate-v2","name":"Validate & Normalize","type":"n8n-nodes-base.code","typeVersion":2,"position":[440,300]
    },
    {
      "parameters":{"jsCode":"const data=$json; if(!data.success) return [{json:data}]; const lead=data.lead; let score=0; if(lead.employees>=10) score+=20; if(lead.employees>=50) score+=20; if(lead.interest==='automation') score+=30; if(lead.interest==='ai') score+=30; if(lead.interest==='integration') score+=25; const classification=score>=60?'hot':score>=30?'warm':'cold'; return [{json:{success:true,lead:{...lead,score,classification},processedAt:new Date().toISOString()}}];"},
      "id":"score-v2","name":"Lead Scoring","type":"n8n-nodes-base.code","typeVersion":2,"position":[680,300]
    },
