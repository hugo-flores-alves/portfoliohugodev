    {
      "parameters":{"jsCode":"const input=$json.body ?? $json;\nconst email=String(input.email ?? '').trim().toLowerCase();\nconst rawStatus=String(input.status ?? '').trim();\nconst allowed=['Novo','Contato','Reunião','Proposta','Ganho','Perdido'];\nconst status=allowed.find(s=>s.toLowerCase()===rawStatus.toLowerCase());\nconst followUpDays=Math.max(0,Number(input.followUpDays ?? 0));\nconst observacoes=String(input.observacoes ?? '').trim();\nconst errors=[];\nif(!email) errors.push('email is required');\nif(!status) errors.push('invalid status');\nif(!Number.isFinite(followUpDays)) errors.push('followUpDays must be a number');\nif(errors.length) return [{json:{valid:false,errors}}];\nconst now=new Date();\nlet next='';\nif(!['Ganho','Perdido'].includes(status) && followUpDays>0){ const d=new Date(now); d.setDate(d.getDate()+followUpDays); next=d.toISOString(); }\nreturn [{json:{valid:true,email,status,observacoes,ultimoContato:now.toISOString(),proximoFollowUp:next}}];"},
      "id":"validate-crm","name":"Validate CRM Update","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,300]
